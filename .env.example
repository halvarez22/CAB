# Server-only (Vercel / local serverless). NUNCA prefijar VITE_ para la key.
GROQ_API_KEY=
# Override del modelo (consultar GET /openai/v1/models en tu cuenta Groq).
# Default código: llama-3.3-70b-versatile — muchas cuentas demo usan openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Cliente: solo flag de UI (I-A2). No contiene secretos. "true" para mostrar CTA.
VITE_TUTOR_ENABLED=false
